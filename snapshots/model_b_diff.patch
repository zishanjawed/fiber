+@app.post("/api/documents/bulk-upload", response_model=BatchUploadResponse)
+async def bulk_upload_documents(
+    files: List[UploadFile] = File(...),
+    subject: str = Form(None),
+    tags: str = Form(None),
+    current_user: dict = Depends(get_current_user),
+    db=Depends(get_mongodb)
+):
+    """
+    Bulk upload multiple documents with concurrent processing.
+
+    Validates all files first, then processes them concurrently with a semaphore limit.
+    Tracks batch progress in MongoDB and emits WebSocket updates.
+
+    Validation Rules:
+    - Max 50 files per batch
+    - Max 50MB per file
+    - Max 500MB total batch size
+    - Allowed types: PDF, DOCX, TXT, MD
+
+    Args:
+        files: List of uploaded files
+        subject: Optional subject for all documents
+        tags: Optional comma-separated tags for all documents
+        current_user: Authenticated user from JWT token
+        db: MongoDB database instance
+
+    Returns:
+        BatchUploadResponse with batch_id and status
+    """
+    # Extract user_id from authenticated token (not from client form data)
+    user_id = current_user["user_id"]
+
+    batch_id = str(uuid4())
+    logger.info(f"[Batch {batch_id}] Bulk upload request from user {user_id}: {len(files)} files")
+
+    # RATE LIMITING: Check user's upload limits
+    now = datetime.utcnow()
+    one_hour_ago = now - timedelta(hours=1)
+    one_day_ago = now - timedelta(days=1)
+
+    # Check batches per hour (limit: 5)
+    recent_batches = await db.batch_jobs.count_documents({
+        "user_id": user_id,
+        "created_at": {"$gte": one_hour_ago}
+    })
+    if recent_batches >= 5:
+        raise HTTPException(
+            status_code=429,
+            detail="Rate limit exceeded: Maximum 5 batch uploads per hour"
+        )
+
+    # Check files per day (limit: 200)
+    daily_files = await db.batch_jobs.aggregate([
+        {"$match": {
+            "user_id": user_id,
+            "created_at": {"$gte": one_day_ago}
+        }},
+        {"$group": {
+            "_id": None,
+            "total_files": {"$sum": "$total_files"}
+        }}
+    ]).to_list(1)
+
+    daily_file_count = daily_files[0]["total_files"] if daily_files else 0
+    if daily_file_count + len(files) > 200:
+        raise HTTPException(
+            status_code=429,
+            detail=f"Rate limit exceeded: Maximum 200 files per day. Current: {daily_file_count}, Requesting: {len(files)}"
+        )
+
+    # Check GB per day (limit: 10GB)
+    daily_storage = await db.batch_jobs.aggregate([
+        {"$match": {
+            "user_id": user_id,
+            "created_at": {"$gte": one_day_ago}
+        }},
+        {"$unwind": "$files"},
+        {"$group": {
+            "_id": None,
+            "total_mb": {"$sum": "$files.file_size_mb"}
+        }}
+    ]).to_list(1)
+
+    daily_storage_mb = daily_storage[0]["total_mb"] if daily_storage else 0
+    daily_storage_gb = daily_storage_mb / 1024
+
+    # Calculate incoming batch size (will be calculated precisely during file validation below)
+    # For now, do preliminary check assuming all files are max size
+    estimated_batch_size_mb = len(files) * MAX_FILE_SIZE_MB
+    if daily_storage_gb + (estimated_batch_size_mb / 1024) > 10:
+        raise HTTPException(
+            status_code=429,
+            detail=f"Rate limit exceeded: Maximum 10GB per day. Current: {daily_storage_gb:.2f}GB"
+        )
+
+    logger.info(f"[Batch {batch_id}] Rate limits passed - Batches: {recent_batches}/5, Files: {daily_file_count}/200, Storage: {daily_storage_gb:.2f}GB/10GB")
+
+    # Validation constants
+    MAX_FILES = 50
+    MAX_FILE_SIZE_MB = 50
+    MAX_BATCH_SIZE_MB = 500
+    ALLOWED_EXTENSIONS = ['pdf', 'md', 'txt', 'docx', 'doc']
+
+    # Parse tags
+    tags_list = []
+    if tags:
+        tags_list = [tag.strip() for tag in tags.split(',') if tag.strip()]
+
+    # Validate file count
+    if len(files) == 0:
+        raise FileValidationError(
+            "No files provided",
+            details={"batch_id": batch_id}
+        )
+
+    if len(files) > MAX_FILES:
+        raise FileValidationError(
+            f"Too many files. Maximum {MAX_FILES} files per batch",
+            details={"batch_id": batch_id, "file_count": len(files)}
+        )
+
+    # Validate individual files and calculate total size
+    rejected_files = []
+    accepted_files = []  # Now stores (file, file_size_mb, idx) without content
+    total_size_mb = 0
+
+    # Validate files WITHOUT keeping content in memory
+    for idx, file in enumerate(files):
+        # Validate extension BEFORE reading
+        file_extension = file.filename.split('.')[-1].lower()
+        if file_extension not in ALLOWED_EXTENSIONS:
+            rejected_files.append({
+                "filename": file.filename,
+                "reason": f"Unsupported file type. Allowed: {', '.join(ALLOWED_EXTENSIONS)}"
+            })
+            continue
+
+        # Get file size efficiently without reading entire content
+        # Seek to end to get size, then reset
+        await file.seek(0, 2)  # SEEK_END
+        file_size_bytes = await file.tell()
+        await file.seek(0)  # Reset to beginning
+
+        file_size_mb = file_size_bytes / (1024 * 1024)
+
+        # Validate file size
+        if file_size_mb > MAX_FILE_SIZE_MB:
+            rejected_files.append({
+                "filename": file.filename,
+                "reason": f"File too large ({file_size_mb:.1f}MB). Maximum {MAX_FILE_SIZE_MB}MB per file"
+            })
+            # File content discarded here - not stored
+            continue
+
+        # Validate total batch size
+        if total_size_mb + file_size_mb > MAX_BATCH_SIZE_MB:
+            rejected_files.append({
+                "filename": file.filename,
+                "reason": f"Would exceed batch size limit of {MAX_BATCH_SIZE_MB}MB"
+            })
+            continue
+
+        total_size_mb += file_size_mb
+        # Store file reference and metadata, NOT content
+        accepted_files.append((file, file_size_mb, idx))
+
+    # Check if any files accepted
+    if len(accepted_files) == 0:
+        raise FileValidationError(
+            "No valid files to process",
+            details={"batch_id": batch_id, "rejected_files": rejected_files}
+        )
+
+    logger.info(f"[Batch {batch_id}] Validated: {len(accepted_files)} accepted, {len(rejected_files)} rejected")
+
+    # Create batch metadata in MongoDB
+    batch_files_status = [
+        BatchFileStatus(
+            filename=file.filename,
+            status="pending",
+            file_size_mb=file_size_mb,
+            upload_index=idx
+        )
+        for file, file_size_mb, idx in accepted_files
+    ]
+
+    batch_metadata = BatchUploadMetadata(
+        batch_id=batch_id,
+        user_id=user_id,
+        total_files=len(accepted_files),
+        files=batch_files_status
+    )
+
+    await db.batch_jobs.insert_one(batch_metadata.model_dump())
+
+    logger.info(f"[Batch {batch_id}] Created batch job record")
+
+    # Publish initial WebSocket status
+    try:
+        from websocket_handler import manager
+        await manager.publish_status(f"batch:{batch_id}", {
+            "type": "batch_started",
+            "batch_id": batch_id,
+            "total_files": len(accepted_files),
+            "completed_files": 0,
+            "failed_files": 0,
+            "status": "processing"
+        })
+    except Exception as e:
+        logger.warning(f"Failed to publish WebSocket status: {e}")
+
+    # Process files concurrently with global semaphore limit (max 5 concurrent across ALL batches)
+    async def process_with_semaphore(file, file_size_mb, idx):
+        async with _BATCH_PROCESSING_SEMAPHORE:
+            # Read file content INSIDE semaphore block to limit memory usage
+            # Only 5 files maximum in memory at once
+            try:
+                # Re-read file content (UploadFile objects can be read multiple times)
+                await file.seek(0)  # Reset to beginning
+                file_content = await file.read()
+
+                result = await asyncio.wait_for(
+                    process_single_file_in_batch(
+                        file=file,
+                        file_content=file_content,
+                        user_id=user_id,
+                        batch_id=batch_id,
+                        file_index=idx,
+                        subject=subject,
+                        tags_list=tags_list,
+                        db=db
+                    ),
+                    timeout=30.0  # 30-second timeout per file
+                )
+
+                # Explicitly delete file_content to free memory immediately
+                del file_content
+
+                return idx, result
+            except asyncio.TimeoutError:
+                logger.error(f"[Batch {batch_id}] Timeout processing {file.filename}")
+                return idx, {
+                    "filename": file.filename,
+                    "content_id": None,
+                    "status": "failed",
+                    "error_message": "Processing timeout (30s)",
+                    "file_size_mb": file_size_mb
+                }
+            except Exception as e:
+                logger.error(f"[Batch {batch_id}] Error processing {file.filename}: {e}")
+                return idx, {
+                    "filename": file.filename,
+                    "content_id": None,
+                    "status": "failed",
+                    "error_message": str(e),
+                    "file_size_mb": file_size_mb
+                }
+
+    # Launch all processing tasks
+    # File content now read lazily inside semaphore, not stored in tasks
+    tasks = [
+        process_with_semaphore(file, file_size_mb, idx)
+        for file, file_size_mb, idx in accepted_files
+    ]
+
+    # Start background task to process files and update batch status
+    asyncio.create_task(
+        process_batch_files(batch_id, tasks, db)
+    )
+
+    # Return immediately with batch_id
+    return BatchUploadResponse(
+        batch_id=batch_id,
+        total_files=len(files),
+        accepted_files=len(accepted_files),
+        rejected_files=rejected_files,
+        message=f"Batch upload started. Processing {len(accepted_files)} files."
+    )
+
+
+async def process_batch_files(batch_id: str, tasks: list, db):
+    """
+    Background task to process all files in a batch and update status.
+    """
+    try:
+        logger.info(f"[Batch {batch_id}] Starting background processing of {len(tasks)} files")
+
+        # Process all files
+        results = await asyncio.gather(*tasks, return_exceptions=True)
+
+        # Update batch status based on results
+        completed_count = 0
+        failed_count = 0
+
+        for idx, result in results:
+            if isinstance(result, Exception):
+                logger.error(f"[Batch {batch_id}] Task {idx} raised exception: {result}")
+                failed_count += 1
+                status_update = {
+                    "status": "failed",
+                    "error_message": str(result)
+                }
+            else:
+                if result["status"] in ["completed", "processing"]:
+                    completed_count += 1
+                else:
+                    failed_count += 1
+
+                status_update = {
+                    "status": result["status"],
+                    "content_id": result.get("content_id"),
+                    "error_message": result.get("error_message"),
+                    "total_chunks": result.get("total_chunks")
+                }
+
+            # Update individual file status
+            await db.batch_jobs.update_one(
+                {"batch_id": batch_id, "files.upload_index": idx},
+                {"$set": {
+                    f"files.$.status": status_update["status"],
+                    f"files.$.content_id": status_update.get("content_id"),
+                    f"files.$.error_message": status_update.get("error_message"),
+                    f"files.$.total_chunks": status_update.get("total_chunks"),
+                }}
+            )
+
+        # Determine overall batch status
+        if failed_count == len(tasks):
+            batch_status = "failed"
+        elif failed_count > 0:
+            batch_status = "partial"
+        else:
+            batch_status = "completed"
+
+        # Update batch metadata
+        await db.batch_jobs.update_one(
+            {"batch_id": batch_id},
+            {"$set": {
+                "completed_files": completed_count,
+                "failed_files": failed_count,
+                "status": batch_status,
+                "updated_at": datetime.utcnow()
+            }}
+        )
+
+        logger.info(f"[Batch {batch_id}] Completed: {completed_count} succeeded, {failed_count} failed")
+
+        # Publish final WebSocket status
+        try:
+            from websocket_handler import manager
+            await manager.publish_status(f"batch:{batch_id}", {
+                "type": "batch_completed",
+                "batch_id": batch_id,
+                "total_files": len(tasks),
+                "completed_files": completed_count,
+                "failed_files": failed_count,
+                "status": batch_status
+            })
+        except Exception as e:
+            logger.warning(f"Failed to publish final WebSocket status: {e}")
+
+    except Exception as e:
+        logger.error(f"[Batch {batch_id}] Fatal error in batch processing: {e}")
+
+        # Update batch to failed
+        await db.batch_jobs.update_one(
+            {"batch_id": batch_id},
+            {"$set": {
+                "status": "failed",
+                "updated_at": datetime.utcnow()
+            }}
+        )
+
+
+@app.get("/api/documents/batch/{batch_id}")
+async def get_batch_status(batch_id: str, db=Depends(get_mongodb)):
+    """
+    Get current status of a batch upload.
+
+    Returns detailed information about batch progress including per-file status.
+
+    Args:
+        batch_id: Batch ID to query
+        db: MongoDB database instance
+
+    Returns:
+        Batch status with file-level details
+    """
+    batch = await db.batch_jobs.find_one({"batch_id": batch_id})
+
+    if not batch:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail=f"Batch {batch_id} not found"
+        )
+
+    # Remove MongoDB ObjectId
+    if "_id" in batch:
+        del batch["_id"]
+
+    # Convert datetime fields
+    for date_field in ["created_at", "updated_at"]:
+        if date_field in batch and hasattr(batch[date_field], "isoformat"):
+            batch[date_field] = batch[date_field].isoformat()
+
+    return batch
+
+
